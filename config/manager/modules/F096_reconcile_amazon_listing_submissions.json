  "owner_entrypoint": "scripts/flows/F/F096_reconcile_amazon_listing_submissions.py",
  "worker_entrypoint": "scripts/flows/F/F096_reconcile_amazon_listing_submissions.py",
  "health_sources": [
    {
      "name": "amazon_listing_health",
      "path": "out/systems/F/health/amazon_listing_health.csv",
      "required": false,
      "max_age_minutes": 43200
    }
  ],
  "status_sources": [
    {
      "name": "amazon_listing_submission_events",
      "path": "out/systems/F/history/amazon_listing_submission_events.csv",
      "required": false,
      "max_age_minutes": 43200
    },
    {
      "name": "amazon_listing_readback_events",
      "path": "out/systems/F/history/amazon_listing_readback_events.csv",
      "required": false,
      "max_age_minutes": 43200
    }
  ],
  "outputs": [
    {
      "name": "amazon_listing_reconciliation_live",
      "path": "out/systems/F/live/amazon_listing_reconciliation_live.csv",
      "required": false,
      "max_age_minutes": 43200
    }
  ],
  "freshness_rules": [
    "listing_reconciliation_warn_after_43200_minutes",
    "reconciliation_is_not_product_fact_alignment"
  ],
  "needs_user_signals": [
    "listing_reconciliation_mismatch",
    "product_fact_alignment_requested",
    "manual_listing_review_required"
  ],
  "safe_actions": [
    "read_status",
    "read_report",
    "read_snapshot"
  ],
  "forbidden_actions": [
    "edit_worker_logic",
    "run_worker_cycle",
    "write_google_sheets",
    "change_queue_state",
    "change_pricing",
    "delete_outputs",
    "restart_worker",
    "approve_f061_handoff",
    "write_live_scanner_inbox",
    "run_f061",
    "reconcile_amazon_listing_submissions",
    "call_amazon_api",
    "change_product_db_facts",
    "align_local_db"
  ],
  "manager_notes": "Manager label only. MOT may inspect reconciliation proof but must not align local facts or change listing state."
}
