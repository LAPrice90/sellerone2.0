{
  "id": "FPM060_build_status_dashboard",
  "display_name": "FPM060 Status Dashboard",
  "flow": "F",
  "purpose": "Describe the F price-list queue dashboard so the manager can explain supplier queue state, recommended supplier, and handoff preview status without touching the scanner.",
  "owner_entrypoint": "scripts/flows/F/price_list_manager/FPM060_build_status_dashboard.py",
  "worker_entrypoint": "scripts/flows/F/price_list_manager/FPM060_build_status_dashboard.py",
  "health_sources": [
    {
      "name": "test_mode_health",
      "path": "out/systems/F/price_list_manager/test_mode/health.csv",
      "required": false,
      "max_age_minutes": 10080
    },
    {
      "name": "status_dashboard",
      "path": "out/systems/F/price_list_manager/test_mode/status_dashboard.csv",
      "required": false,
      "max_age_minutes": 10080
    }
  ],
  "status_sources": [
    {
      "name": "supplier_registry",
      "path": "out/systems/F/price_list_manager/test_mode/supplier_registry.csv",
      "required": false,
      "max_age_minutes": 10080
    },
    {
      "name": "manager_decisions",
      "path": "out/systems/F/price_list_manager/test_mode/manager_decisions.csv",
      "required": false,
      "max_age_minutes": 10080
    },
    {
      "name": "f061_handoff_preview",
      "path": "out/systems/F/price_list_manager/test_mode/f061_handoff_preview.csv",
      "required": false,
      "max_age_minutes": 10080
    }
  ],
  "outputs": [
    {
      "name": "status_dashboard_csv",
      "path": "out/systems/F/price_list_manager/test_mode/status_dashboard.csv",
      "required": false,
      "max_age_minutes": 10080
    },
    {
      "name": "status_dashboard_html",
      "path": "out/systems/F/price_list_manager/test_mode/status_dashboard.html",
      "required": false,
      "max_age_minutes": 10080
    }
  ],
  "freshness_rules": [
    "status_dashboard_warn_after_10080_minutes",
    "test_mode_health_warn_after_10080_minutes"
  ],
  "needs_user_signals": [
    "manual_file_needed",
    "supplier_source_missing",
    "handoff_approval_required"
  ],
  "safe_actions": [
    "read_status"
  ],
  "forbidden_actions": [
    "edit_worker_logic",
    "run_worker_cycle",
    "write_google_sheets",
    "change_queue_state",
    "change_pricing",
    "delete_outputs",
    "restart_worker",
    "approve_f061_handoff",
    "write_live_scanner_inbox",
    "align_local_db"
  ],
  "manager_notes": "V1.3 registration only. The manager may read dashboard evidence but must not rebuild the dashboard, change queue controls, approve handoff, or touch live F061 files."
}
