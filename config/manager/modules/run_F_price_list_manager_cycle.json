      "path": "out/systems/F/price_list_manager/live/fpm_live_supervisor_state.txt",
      "required": false,
      "max_age_minutes": 180
    }
  ],
  "outputs": [
    {
      "name": "live_cycle_status",
      "path": "out/systems/F/price_list_manager/live/live_cycle_status.csv",
      "required": false,
      "max_age_minutes": 180
    }
  ],
  "freshness_rules": [
