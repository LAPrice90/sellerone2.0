      "required": false,
      "max_age_minutes": 10080
    },
    {
      "name": "source_acquisition_status",
      "path": "out/systems/F/price_list_manager/test_mode/source_acquisition_status.csv",
      "required": false,
      "max_age_minutes": 10080
    },
    {
      "name": "price_list_batches",
      "path": "out/systems/F/price_list_manager/test_mode/price_list_batches.csv",
      "required": false,
      "max_age_minutes": 10080
