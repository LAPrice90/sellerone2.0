  "forbidden_actions": [
    "edit_worker_logic",
    "run_worker_cycle",
    "check_remote_source",
    "download_price_file",
    "write_supplier_inbox_file",
    "delete_local_price_file",
    "delete_downloaded_source_file",
    "write_google_sheets",
    "change_queue_state",
    "change_pricing",
    "delete_outputs",
    "restart_worker",
    "approve_f061_handoff",
    "write_live_scanner_inbox",
    "align_local_db",
    "run_f061"
  ],
  "manager_notes": "Manager proof registration only. The manager may read URL source status and prior import proof, but must not call supplier URLs, download files, delete files, run F061, or change queue/pricing state in this phase."
