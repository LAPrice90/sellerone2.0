{
  "id": "FPM140_check_review_handoff_ready",
  "display_name": "FPM140 Review Handoff Readiness",
  "flow": "F",
  "purpose": "Describe the scanner-to-review handoff readiness checker so the manager can tell whether a completed supplier run is ready for review without publishing or approving rows.",
  "owner_entrypoint": "scripts/flows/F/price_list_manager/FPM140_check_review_handoff_ready.py",
  "worker_entrypoint": "scripts/flows/F/price_list_manager/FPM140_check_review_handoff_ready.py",
  "health_sources": [
    {
      "name": "review_handoff_health",
      "path": "out/systems/F/price_list_manager/live/review_handoff_health.csv",
      "required": false,
      "max_age_minutes": 1440
    },
    {
      "name": "review_handoff_status",
      "path": "out/systems/F/price_list_manager/live/review_handoff_status.csv",
      "required": false,
      "max_age_minutes": 1440
    }
  ],
  "status_sources": [
    {
      "name": "supplier_price_list_run_state",
      "path": "out/systems/F/inbox/supplier_price_list_run_state.csv",
      "required": false,
      "max_age_minutes": 1440
    },
    {
      "name": "supplier_price_list_active_run",
      "path": "out/systems/F/inbox/supplier_price_list_active_run.csv",
      "required": false,
      "max_age_minutes": 1440
    },
    {
      "name": "live_cycle_status",
      "path": "out/systems/F/price_list_manager/live/live_cycle_status.csv",
      "required": false,
      "max_age_minutes": 180
    },
    {
      "name": "f061_child_status",
      "path": "out/systems/F/price_list_manager/live/f061_child_status.txt",
      "required": false,
      "max_age_minutes": 180
    }
  ],
  "outputs": [
    {
      "name": "review_handoff_status",
      "path": "out/systems/F/price_list_manager/live/review_handoff_status.csv",
      "required": false,
      "max_age_minutes": 1440
    },
    {
      "name": "review_handoff_health",
      "path": "out/systems/F/price_list_manager/live/review_handoff_health.csv",
      "required": false,
      "max_age_minutes": 1440
    }
  ],
  "freshness_rules": [
    "review_handoff_status_warn_after_1440_minutes",
    "run_must_be_completed_before_review_handoff_ready",
    "active_pending_rows_must_be_zero_before_review_handoff_ready",
    "scanner_child_must_not_be_active_before_review_handoff_ready"
  ],
  "needs_user_signals": [
    "run_not_completed",
    "active_pending_rows_not_zero",
    "f061_child_active",
    "login_backtrack_pending"
  ],
  "safe_actions": [
    "read_status"
  ],
  "forbidden_actions": [
    "edit_worker_logic",
    "run_worker_cycle",
    "write_google_sheets",
    "change_queue_state",
    "change_pricing",
    "delete_outputs",
    "restart_worker",
    "approve_f061_handoff",
    "write_live_scanner_inbox",
    "align_local_db",
    "apply_live_handoff",
    "run_f061",
    "publish_review_rows"
  ],
  "manager_notes": "V1.3 registration only. The manager may read review handoff readiness evidence but must not run this checker, publish rows, approve rows, restart F061, or change scanner queue state."
}
