"""
Dedupe Product_DB so each seller_sku appears once.
Keeps the most complete row, then newest last_updated_* timestamps.
"""

from __future__ import annotations

from datetime import datetime
from pathlib import Path
from typing import List, Tuple

import gspread


PRODUCT_DB_SHEET_ID = "1b7iREy92vF_a1Lw72g0SOGS7t4-IOSBeeoHetLTN43s"
PRODUCT_DB_TAB = "Product_DB"


def get_gspread_client() -> gspread.Client:
    cred_path = Path("secrets/sellerone-2-0d3642b951a0.json")
    return gspread.service_account(filename=str(cred_path))


def _count_filled(row: List[str]) -> int:
    return sum(1 for v in row if str(v).strip() not in ("", "nan", "None"))


def _parse_latest_ts(row: List[str], headers: List[str]) -> datetime:
    ts_cols = [h for h in headers if h.startswith("last_updated")]
    latest = None
    for h in ts_cols:
        try:
            idx = headers.index(h)
        except ValueError:
            continue
        val = row[idx] if idx < len(row) else ""
        if not val:
            continue
        try:
            dt = datetime.fromisoformat(val.replace("Z", "+00:00"))
        except Exception:
            continue
        if latest is None or dt > latest:
            latest = dt
    return latest or datetime.min


def main() -> None:
    client = get_gspread_client()
    sheet = client.open_by_key(PRODUCT_DB_SHEET_ID)
    ws = sheet.worksheet(PRODUCT_DB_TAB)
    rows = ws.get_all_values()
    if not rows:
        print({"status": "skip", "reason": "product_db_empty"})
        return

    headers = rows[0]
    if "seller_sku" not in headers:
        print({"status": "skip", "reason": "seller_sku_missing"})
        return
    sku_idx = headers.index("seller_sku")

    # Normalize row lengths
    data = []
    for r in rows[1:]:
        if len(r) < len(headers):
            r = r + [""] * (len(headers) - len(r))
        data.append(r)

    buckets = {}
    for r in data:
        sku = (r[sku_idx] or "").strip()
        if not sku:
            continue
        buckets.setdefault(sku, []).append(r)

    kept_rows = []
    dropped = 0
    for sku, items in buckets.items():
        if len(items) == 1:
            kept_rows.append(items[0])
            continue
        # Pick the row with most filled fields, then latest update timestamp.
        ranked: List[Tuple[int, datetime, List[str]]] = []
        for r in items:
            filled = _count_filled(r)
            latest = _parse_latest_ts(r, headers)
            ranked.append((filled, latest, r))
        ranked.sort(key=lambda t: (t[0], t[1]), reverse=True)
        kept_rows.append(ranked[0][2])
        dropped += len(items) - 1

    ws.clear()
    ws.update(range_name="A1", values=[headers] + kept_rows)
    print({"status": "success", "kept": len(kept_rows), "dropped": dropped})


if __name__ == "__main__":
    main()

