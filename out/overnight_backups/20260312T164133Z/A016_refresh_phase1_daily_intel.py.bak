def _norm(value: object) -> str:
    return str(value or "").strip()


def _to_float(value: object) -> float | None:
    raw = _norm(value)
    if not raw:
        return None
    try:
        return float(raw)
    except Exception:
        return None


def _to_int(value: object) -> int | None:
    raw = _norm(value)
    if not raw:
        return None
    try:
        return int(float(raw))
    except Exception:
        return None


def _to_dt(value: object) -> datetime | None:
    text = _norm(value)
    if not text:
        return None
    try:
        raw = text.replace("Z", "+00:00")
        dt = datetime.fromisoformat(raw)
        if dt.tzinfo is None:
            return dt.replace(tzinfo=timezone.utc)
        return dt.astimezone(timezone.utc)
    except Exception:
        return None


def _intel_progress_log_path() -> Path:
    raw = _norm(os.environ.get("A016_PROGRESS_LOG_PATH", "") or os.environ.get("H_PHASE1_INTEL_PROGRESS_PATH", ""))
    return Path(raw) if raw else DEFAULT_INTEL_PROGRESS_LOG_PATH


def _append_intel_progress(run_id: str, checkpoint: str, **fields: object) -> None:
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    parts = [f"utc={ts}", f"run_id={_norm(run_id)}", f"checkpoint={_norm(checkpoint)}"]
    for key, value in fields.items():
        k = _norm(key)
        if not k:
            continue
        parts.append(f"{k}={_norm(value)}")
    line = " ".join(parts) + "\n"
    try:
        path = _intel_progress_log_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8", newline="\n") as fh:
            fh.write(line)
    except Exception:
        pass


def _format_elapsed_seconds(value: float) -> str:
    return f"{max(float(value), 0.0):.1f}"


def _loop_progress_fields(
    *,
    sku: str,
    loop_index: int,
    total_rows: int,
    step: str,
    cpt_due_bucket: str = "",
    writer_mode: str = "",
    asin: str = "",
    extra: dict[str, object] | None = None,
) -> dict[str, object]:
    payload: dict[str, object] = {
        "sku": _norm(sku).upper(),
        "loop_index": loop_index,
        "total_rows": total_rows,
        "step": _norm(step),
    }
    if cpt_due_bucket:
        payload["cpt_due_bucket"] = _norm(cpt_due_bucket)
    if writer_mode:
        payload["writer_mode"] = _norm(writer_mode).upper()
    if asin:
        payload["asin"] = _norm(asin).upper()
    if extra:
        payload.update(extra)
    return payload


@contextmanager
def _loop_step_heartbeat(
    *,
    run_id: str,
    sku: str,
    loop_index: int,
    total_rows: int,
    step: str,
    cpt_due_bucket: str = "",
    writer_mode: str = "",
    asin: str = "",
    slow_step_seconds: float = 0.0,
    extra_enter: dict[str, object] | None = None,
    extra_exit: dict[str, object] | None = None,
):
    enter_fields = _loop_progress_fields(
        sku=sku,
        loop_index=loop_index,
        total_rows=total_rows,
        step=step,
        cpt_due_bucket=cpt_due_bucket,
        writer_mode=writer_mode,
        asin=asin,
        extra=extra_enter,
    )
    _append_intel_progress(run_id, "loop_step_enter", **enter_fields)
    start_monotonic = time.monotonic()
    stop_event = threading.Event()
    heartbeat_thread: threading.Thread | None = None

    if slow_step_seconds > 0:
        def _heartbeat() -> None:
            heartbeat_count = 0
            while not stop_event.wait(slow_step_seconds):
                heartbeat_count += 1
                _append_intel_progress(
                    run_id,
                    "loop_step_running",
                    **_loop_progress_fields(
                        sku=sku,
                        loop_index=loop_index,
                        total_rows=total_rows,
                        step=step,
                        cpt_due_bucket=cpt_due_bucket,
                        writer_mode=writer_mode,
                        asin=asin,
                        extra={
                            "elapsed_seconds": _format_elapsed_seconds(time.monotonic() - start_monotonic),
                            "heartbeat_count": heartbeat_count,
                        },
                    ),
                )

        heartbeat_thread = threading.Thread(
            target=_heartbeat,
            name=f"a016_loop_step_{_norm(step)}",
            daemon=True,
        )
        heartbeat_thread.start()

    try:
        yield
    finally:
        stop_event.set()
        if heartbeat_thread is not None:
            heartbeat_thread.join(timeout=0.2)
        exit_fields = dict(extra_exit or {})
        exit_fields["elapsed_seconds"] = _format_elapsed_seconds(time.monotonic() - start_monotonic)
        _append_intel_progress(
            run_id,
            "loop_step_exit",
            **_loop_progress_fields(
                sku=sku,
                loop_index=loop_index,
                total_rows=total_rows,
                step=step,
                cpt_due_bucket=cpt_due_bucket,
                writer_mode=writer_mode,
                asin=asin,
                extra=exit_fields,
            ),
        )


_CURRENT_CONTRACT_STAGE = "start"
_PARENT_LOSS_MONITOR_STOP = threading.Event()
_PARENT_LOSS_TRIGGERED = threading.Event()
PARENT_LOSS_CONFIRMATION_POLLS = max(
    int(float(os.environ.get("A016_PARENT_LOSS_CONFIRMATION_POLLS", "3") or "3")),
    2,
)
PARENT_LOSS_MONITOR_INTERVAL_SECONDS = max(
    float(os.environ.get("A016_PARENT_LOSS_MONITOR_INTERVAL_SECONDS", "2") or "2"),
    1.0,
)


def _parent_pid() -> int:
    try:
        pid = int(A016_PARENT_PID_RAW)
    except Exception:
        return 0
    return pid if pid > 0 else 0


def _pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        if os.name == "nt":
            kernel32 = ctypes.windll.kernel32
            query_limited = 0x1000
            synchronize = 0x00100000
            still_active = 259
            handle = kernel32.OpenProcess(synchronize | query_limited, False, pid)
            if handle:
                try:
                    exit_code = ctypes.c_ulong()
                    if kernel32.GetExitCodeProcess(handle, ctypes.byref(exit_code)) != 0:
                        if int(exit_code.value) == still_active:
                            return True
                    else:
                        # Fall through to process-table probes if exit code lookup fails.
                        pass
                finally:
                    kernel32.CloseHandle(handle)
            # Fall back to two process-table probes if the direct handle probe fails.
            tasklist_probe = subprocess.run(
                [
                    "tasklist",
                    "/FI",
                    f"PID eq {pid}",
                    "/FO",
                    "CSV",
                    "/NH",
                ],
                capture_output=True,
                text=True,
                check=False,
                timeout=10,
            )
            if tasklist_probe.returncode == 0 and f'"{pid}"' in tasklist_probe.stdout:
                return True
            cim_probe = subprocess.run(
                [
                    "powershell",
                    "-NoProfile",
                    "-Command",
                    (
                        "$p=Get-CimInstance Win32_Process "
                        f"-Filter \\\"ProcessId={pid}\\\" "
                        "-ErrorAction SilentlyContinue;"
                        "if($p){exit 0};"
                        "exit 1"
                    ),
                ],
                capture_output=True,
                text=True,
                check=False,
                timeout=10,
            )
            return bool(cim_probe.returncode == 0)
        os.kill(pid, 0)
        return True
    except Exception:
        return False


def _note_contract_stage(stage: str) -> None:
    global _CURRENT_CONTRACT_STAGE
    stage_norm = _norm(stage)
    if stage_norm:
        _CURRENT_CONTRACT_STAGE = stage_norm


def _emit_parent_owner_lost(progress_run_id: str) -> None:
    if _PARENT_LOSS_TRIGGERED.is_set():
        return
    _PARENT_LOSS_TRIGGERED.set()
    parent_pid = _parent_pid()
    contract_stage = _CURRENT_CONTRACT_STAGE or "unknown"
    _append_intel_progress(
        progress_run_id,
        "parent_owner_lost",
        parent_pid=parent_pid,
        contract_stage=contract_stage,
        child_pid=os.getpid(),
    )
    payload = {
        "phase1_daily_intel_alignment_status": "failed",
        "phase1_daily_intel_alignment_run_id": _norm(progress_run_id),
        "phase1_daily_intel_alignment_rc": "86",
        "phase1_daily_intel_alignment_error": (
            f"parent_owner_lost parent_pid={parent_pid} "
            f"contract_stage={contract_stage} child_pid={os.getpid()}"
        ),
        "phase1_daily_intel_alignment_error_type": "ParentOwnerLost",
    }
    _write_boundary_state(
        progress_run_id,
        "resolved_failure",
        contract_stage=contract_stage,
        state_reason="parent_owner_lost",
        parent_pid=parent_pid,
        parent_alive="0",
        child_pid=os.getpid(),
        orphan_cleanup="self_exit",
    )
    _emit_failure_payload(payload)


def _start_parent_loss_monitor(progress_run_id: str) -> None:
    parent_pid = _parent_pid()
    if parent_pid <= 0:
        return
    _PARENT_LOSS_MONITOR_STOP.clear()
    _PARENT_LOSS_TRIGGERED.clear()

    def _monitor() -> None:
        miss_count = 0
        while not _PARENT_LOSS_MONITOR_STOP.wait(PARENT_LOSS_MONITOR_INTERVAL_SECONDS):
            if _pid_alive(parent_pid):
                miss_count = 0
                continue
            miss_count += 1
            _append_intel_progress(
                progress_run_id,
                "parent_owner_suspect",
                parent_pid=parent_pid,
                miss_count=miss_count,
                confirmation_polls=PARENT_LOSS_CONFIRMATION_POLLS,
                contract_stage=_CURRENT_CONTRACT_STAGE or "unknown",
                child_pid=os.getpid(),
            )
            if miss_count < PARENT_LOSS_CONFIRMATION_POLLS:
                continue
            if _pid_alive(parent_pid):
                miss_count = 0
                continue
            try:
                _emit_parent_owner_lost(progress_run_id)
            finally:
                os._exit(86)

    thread = threading.Thread(target=_monitor, name="a016_parent_loss_monitor", daemon=True)
    thread.start()


def _write_boundary_state(run_id: str, status: str, **fields: object) -> None:
    if A016_BOUNDARY_STATE_PATH is None:
        return
    contract_stage = _norm(fields.get("contract_stage", ""))
    if contract_stage:
        _note_contract_stage(contract_stage)
    payload: dict[str, object] = {}
    try:
        if A016_BOUNDARY_STATE_PATH.exists():
            raw = json.loads(A016_BOUNDARY_STATE_PATH.read_text(encoding="utf-8"))
            if isinstance(raw, dict):
                payload.update(raw)
    except Exception:
        payload = {}
    payload.update(
        {
            "run_id": _norm(run_id),
            "status": _norm(status),
            "updated_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "owner": "A016",
            "child_pid": os.getpid(),
            "parent_pid": str(_parent_pid()),
            "result_path": str(A016_RESULT_PATH) if A016_RESULT_PATH else _norm(payload.get("result_path", "")),
            "boundary_state_path": str(A016_BOUNDARY_STATE_PATH),
        }
    )
    for key, value in fields.items():
        key_norm = _norm(key)
        if not key_norm:
            continue
        payload[key_norm] = str(value) if value is not None else ""
    A016_BOUNDARY_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = A016_BOUNDARY_STATE_PATH.with_name(f"{A016_BOUNDARY_STATE_PATH.name}.tmp")
    tmp_path.write_text(json.dumps(payload, ensure_ascii=True, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp_path, A016_BOUNDARY_STATE_PATH)


def _write_result_payload(payload: dict[str, object]) -> None:
    if A016_RESULT_PATH is None:
        return
    payload_text = json.dumps(payload, ensure_ascii=True) + "\n"
    A016_RESULT_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = A016_RESULT_PATH.with_name(f"{A016_RESULT_PATH.name}.tmp")
    tmp_path.write_text(payload_text, encoding="utf-8")
    os.replace(tmp_path, A016_RESULT_PATH)
    _append_intel_progress(
        _norm(payload.get("phase1_daily_intel_alignment_run_id", "")),
        "result_payload_write",
        status="ok",
        path=A016_RESULT_PATH,
        bytes=len(payload_text.encode("utf-8")),
    )
    _write_boundary_state(
        _norm(payload.get("phase1_daily_intel_alignment_run_id", "")),
        "active",
        contract_stage="result_payload_written",
        result_bytes=len(payload_text.encode("utf-8")),
        result_ok="1",
    )


def _emit_success_payload(payload: dict[str, object]) -> None:
    payload_text = json.dumps(payload, ensure_ascii=True)
    result_ok = False
    stdout_ok = False
    result_error = ""
    stdout_error = ""
    if A016_RESULT_PATH is not None:
        try:
            _write_result_payload(payload)
            result_ok = A016_RESULT_PATH.exists() and A016_RESULT_PATH.stat().st_size > 0
            if not result_ok:
                result_error = "result_file_missing_after_write"
        except Exception as exc:
            result_error = f"{type(exc).__name__}:{exc}"
    else:
        result_error = "result_path_missing"
    try:
        sys.stdout.write(payload_text + "\n")
        sys.stdout.flush()
        stdout_ok = True
    except Exception as exc:
        stdout_error = f"{type(exc).__name__}:{exc}"
    _append_intel_progress(
        _norm(payload.get("phase1_daily_intel_alignment_run_id", "")),
        "success_payload_emit",
        stdout_ok="1" if stdout_ok else "0",
        result_ok="1" if result_ok else "0",
        result_path=A016_RESULT_PATH if A016_RESULT_PATH else "",
        result_error=result_error,
        stdout_error=stdout_error,
    )
    _write_boundary_state(
        _norm(payload.get("phase1_daily_intel_alignment_run_id", "")),
        "resolved_success",
        contract_stage="success_payload_emit",
        stdout_ok="1" if stdout_ok else "0",
        result_ok="1" if result_ok else "0",
        output_path=_norm(payload.get("phase1_daily_intel_alignment_output_path", "")),
        processed=_norm(payload.get("phase1_daily_intel_alignment_processed_count", "")),
    )
    if not stdout_ok and not result_ok:
        raise RuntimeError(
            "a016 success payload unavailable "
            f"(stdout_ok=0 result_ok=0 result_path={A016_RESULT_PATH} "
            f"result_error={result_error} stdout_error={stdout_error})"
        )


def _emit_failure_payload(payload: dict[str, object]) -> None:
    if A016_RESULT_PATH is None:
        _write_boundary_state(
            _norm(payload.get("phase1_daily_intel_alignment_run_id", "")),
            "resolved_failure",
            contract_stage="failure_payload_emit",
            result_ok="0",
            error=_norm(payload.get("phase1_daily_intel_alignment_error", "")),
        )
        return
    try:
        _write_result_payload(payload)
    except Exception as exc:
        _append_intel_progress(
            _norm(payload.get("phase1_daily_intel_alignment_run_id", "")),
            "failure_payload_emit",
            status="fail",
            path=A016_RESULT_PATH,
            error=f"{type(exc).__name__}:{exc}",
        )
        _write_boundary_state(
            _norm(payload.get("phase1_daily_intel_alignment_run_id", "")),
            "resolved_failure",
            contract_stage="failure_payload_emit",
            result_ok="0",
            error=f"{type(exc).__name__}:{exc}",
        )
    else:
        _append_intel_progress(
            _norm(payload.get("phase1_daily_intel_alignment_run_id", "")),
            "failure_payload_emit",
            status="ok",
            path=A016_RESULT_PATH,
        )
        _write_boundary_state(
            _norm(payload.get("phase1_daily_intel_alignment_run_id", "")),
            "resolved_failure",
            contract_stage="failure_payload_emit",
            result_ok="1",
            error=_norm(payload.get("phase1_daily_intel_alignment_error", "")),
        )


def _sku_trace_enabled() -> bool:
    return _to_bool(os.environ.get("A016_TRACE_SKU_STEPS", "0"), default=False)


def _append_sku_trace(run_id: str, sku: str, step: str, state: str, **fields: object) -> None:
    payload = {"sku": _norm(sku), "step": _norm(step), "state": _norm(state)}
    payload.update(fields)
    _append_intel_progress(run_id, "sku_trace", **payload)


def _build_cpt_error_payload(reason_code: str, detail: str = "") -> dict[str, object]:
    summary = _norm(detail)[:200]
    payload = {
        "cpt_gbp": "",
        "cpt_status": "ERROR",
        "cpt_last_refresh_utc": datetime.now(timezone.utc).replace(microsecond=0).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "reason_codes": ["CPT_ERROR", _norm(reason_code).upper()],
        "error_summary": summary,
    }
    return payload


def _cpt_worker_call(queue: mp.Queue, kwargs: dict[str, object]) -> None:
    try:
        payload = fetch_cpt_for_asin(**kwargs)
        queue.put({"ok": True, "payload": payload})
    except Exception as exc:
        queue.put({"ok": False, "error": f"{type(exc).__name__}:{_norm(exc)}"})


def _fetch_cpt_with_deadline(
    *,
    sku: str,
    asin: str,
    marketplace_id: str,
    run_id: str,
    script_name: str,
    timeout_seconds: float,
    connect_timeout_seconds: float,
    read_timeout_seconds: float,
    token_timeout_seconds: float,
) -> tuple[dict[str, object], str]:
    timeout_s = max(float(timeout_seconds), 1.0)
    ctx = mp.get_context("spawn")
    queue: mp.Queue = ctx.Queue(maxsize=1)
    kwargs = {
        "asin": asin,
        "marketplace_id": marketplace_id,
        "run_id": run_id,
        "script_name": script_name,
        "lwa_timeout_seconds": token_timeout_seconds,
        "connect_timeout_seconds": connect_timeout_seconds,
        "read_timeout_seconds": read_timeout_seconds,
    }
    proc = ctx.Process(target=_cpt_worker_call, args=(queue, kwargs), daemon=True)
    # Guard process startup itself; on Windows, spawn can block before join(timeout) is reachable.
    start_err: dict[str, str] = {}
    started = threading.Event()

    def _start_worker() -> None:
        try:
            proc.start()
        except Exception as exc:
            start_err["error"] = f"{type(exc).__name__}:{_norm(exc)}"
        finally:
            started.set()

    start_thread = threading.Thread(target=_start_worker, name="a016_cpt_spawn_start", daemon=True)
    start_thread.start()
    start_timeout_s = min(timeout_s, 5.0)
    start_thread.join(start_timeout_s)
    if not started.is_set():
        return (
            _build_cpt_error_payload(
                "CPT_WORKER_START_TIMEOUT",
                f"start_timeout_seconds={start_timeout_s:.1f} sku={sku} asin={asin}",
            ),
            "worker_start_timeout",
        )
    if start_err.get("error"):
        return (
            _build_cpt_error_payload("CPT_WORKER_START_EXCEPTION", start_err["error"]),
            "worker_start_exception",
        )
    proc.join(timeout_s)
    if proc.is_alive():
        try:
            proc.terminate()
        except Exception:
            pass
        proc.join(3.0)
        return (
            _build_cpt_error_payload("CPT_TIMEOUT", f"timeout_seconds={timeout_s:.1f} sku={sku} asin={asin}"),
            "timeout",
        )
    try:
        msg = queue.get_nowait()
    except Exception:
        exit_code = proc.exitcode if proc.exitcode is not None else "unknown"
        return (
            _build_cpt_error_payload("CPT_WORKER_NO_RESULT", f"exit_code={exit_code} sku={sku} asin={asin}"),
            "worker_no_result",
        )
    if not bool(msg.get("ok", False)):
        return (
            _build_cpt_error_payload("CPT_WORKER_EXCEPTION", _norm(msg.get("error", ""))),
            "worker_exception",
        )
    payload = msg.get("payload")
    if not isinstance(payload, dict):
        return (
            _build_cpt_error_payload("CPT_WORKER_INVALID_PAYLOAD", f"type={type(payload).__name__}"),
            "worker_invalid_payload",
        )
    return payload, ""


def _parse_scalar(text: str) -> object:
    raw = str(text).strip()
    if raw == "":
        return ""
    low = raw.lower()
    if low in {"true", "yes", "on"}:
        return True
    if low in {"false", "no", "off"}:
        return False
    try:
        if "." in raw:
            return float(raw)
        return int(raw)
    except Exception:
        return raw.strip("\"'")


def _simple_yaml_load(path: Path) -> dict:
    root: dict[str, object] = {}
    stack: list[tuple[int, dict[str, object]]] = [(-1, root)]
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        indent = len(raw_line) - len(raw_line.lstrip(" "))
        text = line.strip()
        while len(stack) > 1 and indent <= stack[-1][0]:
            stack.pop()
        parent = stack[-1][1]
        if ":" not in text:
            continue
        key, value = text.split(":", 1)
        key = key.strip()
        value = value.strip()
        if value == "":
            child: dict[str, object] = {}
            parent[key] = child
            stack.append((indent, child))
            continue
        parent[key] = _parse_scalar(value)
    return root


def _cfg_get(cfg: dict, *keys: str, default: object = "") -> object:
    cur: object = cfg
    for key in keys:
        if not isinstance(cur, dict):
            return default
        if key not in cur:
            return default
        cur = cur[key]
    return cur


def _to_bool(value: object, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    text = str(value or "").strip().lower()
    if text in {"1", "true", "yes", "y", "on"}:
        return True
    if text in {"0", "false", "no", "n", "off"}:
        return False
    return default


def _cfg_float(cfg: dict, *keys: str, default: float) -> float:
    value = _to_float(_cfg_get(cfg, *keys, default=default))
    if value is None:
        return float(default)
    return float(value)


def _latest_listing_map() -> dict[str, dict[str, str]]:
    files = sorted(OUT.glob("listing_offer_snapshot_*.csv"))
    if not files:
        return {}
    try:
        df = pd.read_csv(files[-1], dtype=str).fillna("")
    except Exception:
        return {}
    out: dict[str, dict[str, str]] = {}
    for _, row in df.iterrows():
        rec = {str(k): _norm(v) for k, v in row.to_dict().items()}
        sku = _norm(rec.get("sku", "")).upper()
        if not sku or sku in out:
            continue
        out[sku] = rec
    return out


def _load_manual_caps() -> tuple[dict[str, str], dict[str, str]]:
    by_sku: dict[str, str] = {}
    by_asin: dict[str, str] = {}
    if not MANUAL_CAPS_PATH.exists():
        return by_sku, by_asin
    try:
        df = pd.read_csv(MANUAL_CAPS_PATH, dtype=str).fillna("")
    except Exception:
        return by_sku, by_asin
    for _, row in df.iterrows():
        cap = _to_float(row.get("manual_max_price_gbp", ""))
        if cap is None or cap <= 0:
            continue
        cap_text = f"{cap:.2f}"
        sku = _norm(row.get("sku", "")).upper()
        asin = _norm(row.get("asin", "")).upper()
        if sku and sku not in by_sku:
            by_sku[sku] = cap_text
        if asin and asin not in by_asin:
            by_asin[asin] = cap_text
    return by_sku, by_asin


def _resolve_manual_cap(
    *,
    sku: str,
    asin: str,
    listing_row: dict[str, str],
    cfg: dict,
    manual_cap_by_sku: dict[str, str],
    manual_cap_by_asin: dict[str, str],
) -> str:
    cap = manual_cap_by_sku.get(sku) or manual_cap_by_asin.get(asin)
    if _norm(cap):
        return _norm(cap)
    allow_config_fallback = _to_bool(_cfg_get(cfg, "daily_intel", "allow_manual_cap_fallback", default=False), default=False)
    if allow_config_fallback:
        configured_default = _norm(_cfg_get(cfg, "boundaries", "manual_cap_gbp", default=""))
        if configured_default:
            return configured_default
    return ""


def _resolve_compliance_anchor(
    *,
    listing_row: dict[str, str],
    manual_cap_gbp: str,
    cfg: dict,
) -> str:
    configured = _norm(_cfg_get(cfg, "daily_intel", "compliance_anchor_gbp", default=""))
    if configured:
        return configured
    if _norm(manual_cap_gbp):
        return manual_cap_gbp
    buy_box = _to_float(listing_row.get("buy_box_price", ""))
    if buy_box is not None and buy_box > 0:
        return f"{buy_box:.2f}"
    our_price = _to_float(listing_row.get("our_price", ""))
    if our_price is not None and our_price > 0:
        return f"{our_price:.2f}"
    return ""


def _cpt_age_due(
    *,
    tier: str,
    cpt_status: str,
    last_refresh_utc: str,
    now_utc: str,
    no_cpt_recheck_hours: float = 168.0,
) -> tuple[bool, list[str], str]:
    reasons: list[str] = []
    tier_up = _norm(tier).upper()
    if tier_up == "PARKED":
        return False, ["CPT_SKIP_PARKED"], "SKIP"

    status_up = _norm(cpt_status).upper() or "MISSING"
    last_dt = _to_dt(last_refresh_utc)
    now_dt = _to_dt(now_utc) or datetime.now(timezone.utc)

    if status_up == "NO_CPT":
        weekly_window = timedelta(hours=max(float(no_cpt_recheck_hours), 1.0))
        if last_dt is None:
            reasons.append("CPT_DUE_NO_CPT_WEEKLY")
            return True, reasons, "DUE_NO_CPT_WEEKLY"
        age = now_dt - last_dt
        if age >= weekly_window:
            reasons.append("CPT_DUE_NO_CPT_WEEKLY")
            return True, reasons, "DUE_NO_CPT_WEEKLY"
        reasons.append("CPT_SKIP_NO_CPT_WEEKLY_NOT_DUE")
        return False, reasons, "SKIP_NO_CPT_WEEKLY"

    # Recovery mode: if CPT is missing/error, retry once per UTC day.
    if status_up in {"MISSING", "ERROR"}:
        if last_dt is None:
            reasons.append("CPT_DUE_STATUS_RECOVERY_NO_LAST_REFRESH")
            return True, reasons, "DUE_MISSING_ERROR"
        if last_dt.date() < now_dt.date():
            reasons.append("CPT_DUE_STATUS_RECOVERY_NEW_DAY")
            return True, reasons, "DUE_MISSING_ERROR"
        reasons.append("CPT_SKIP_STATUS_RECOVERY_ALREADY_RETRIED_TODAY")
        return False, reasons, "SKIP"

    if tier_up == "ACTIVE_WRITE":
        max_age = timedelta(hours=24)
    else:
        max_age = timedelta(hours=72)

    if last_dt is None:
        reasons.append("CPT_DUE_MISSING_LAST_REFRESH")
        return True, reasons, "DUE_STALE"
    age = now_dt - last_dt
    if age >= max_age:
        reasons.append(f"CPT_DUE_STALE_{int(max_age.total_seconds() // 3600)}H")
        return True, reasons, "DUE_STALE"
    reasons.append("CPT_SKIP_FRESH")
    return False, reasons, "SKIP"


def _compute_cpt_risk(
    *,
    cpt_gbp: str,
    buy_box_gbp: str,
    high_pct: float,
    medium_pct: float,
) -> tuple[str, str, str, list[str]]:
    reasons: list[str] = []
    cpt = _to_float(cpt_gbp)
    buy_box = _to_float(buy_box_gbp)
    if cpt is None or cpt <= 0:
        reasons.append("CPT_RISK_UNKNOWN_MISSING_CPT")
        return "UNKNOWN", "", "", reasons
    if buy_box is None or buy_box <= 0:
        reasons.append("CPT_RISK_UNKNOWN_MISSING_BUY_BOX")
        return "UNKNOWN", "", "", reasons
    delta = buy_box - cpt
    pct = (delta / cpt) * 100 if cpt else 0.0
    if pct >= high_pct:
        band = "HIGH"
        reasons.append("CPT_RISK_HIGH")
    elif pct >= medium_pct:
        band = "MEDIUM"
        reasons.append("CPT_RISK_MEDIUM")
    else:
        band = "LOW"
        reasons.append("CPT_RISK_LOW")
    return band, f"{delta:.2f}", f"{pct:.2f}", reasons


def _load_cfg(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        return _simple_yaml_load(path)
    except Exception:
        return {}


def _active_authoritative_daily_intel_path() -> Path:
    return phase1_storage.phase1_table_path("sku_daily_intel")


def _daily_intel_schema() -> list[str]:
    base = list(phase1_storage.PHASE1_TABLE_SCHEMAS["sku_daily_intel"])
    for col in ("compliance_status", "compliance_reason_code"):
        if col not in base:
            base.append(col)
    return base


def _stock_qty_map_from_path(path: Path) -> dict[str, float]:
    if not path.exists():
        return {}
    try:
        df = pd.read_csv(path, dtype=str).fillna("")
    except Exception:
        return {}
    if df.empty:
        return {}

    sku_col = ""
    for candidate in ("seller_sku", "sku", "seller-sku", "SKU"):
        if candidate in df.columns:
            sku_col = candidate
            break
    if not sku_col:
        return {}

    out: dict[str, float] = {}
    for _, row in df.iterrows():
        sku = _norm(row.get(sku_col, "")).upper()
        if not sku:
            continue
        available = None
        for col in ("available", "available_qty", "stock_available", "stock"):
            if col in df.columns:
                available = _to_float(row.get(col, ""))
                if available is not None:
                    break
        total_qty = None
        for col in ("total_quantity", "total_qty", "stock_total", "quantity"):
            if col in df.columns:
                total_qty = _to_float(row.get(col, ""))
                if total_qty is not None:
                    break
        qty = available
        if (qty is None or qty <= 0) and total_qty is not None:
            qty = total_qty
        if qty is None:
            continue
        prev = out.get(sku)
        if prev is None or qty > prev:
            out[sku] = float(qty)
    return out


def _load_stock_qty_by_sku() -> tuple[dict[str, float], str]:
    candidates: list[Path] = []
    inventory_snapshots = sorted(OUT.glob("inventory_snapshot_*.csv"))
    if inventory_snapshots:
        candidates.append(inventory_snapshots[-1])
    if INVENTORY_SUMMARIES_PATH.exists():
        candidates.append(INVENTORY_SUMMARIES_PATH)
    if STOCK_SNAPSHOT_LATEST_PATH.exists():
        candidates.append(STOCK_SNAPSHOT_LATEST_PATH)

    for path in candidates:
        qty_map = _stock_qty_map_from_path(path)
        if qty_map:
            return qty_map, str(path)
    return {}, ""


def _load_required_non_parked_skus(scope_df: pd.DataFrame) -> tuple[list[str], dict[str, int]]:
    required_daily_skus, meta = daily_intel_required_skus.derive_required_daily_skus(
        scope_df,
        scope_path=phase1_sku_scope.SCOPE_OUTPUT_PATH,
        parked_skus_path=PARKED_SKUS_PATH,
        out_dir=OUT,
        inventory_summaries_path=INVENTORY_SUMMARIES_PATH,
        stock_snapshot_latest_path=STOCK_SNAPSHOT_LATEST_PATH,
    )
    return required_daily_skus, {
        "required": int(meta.get("required", 0) or 0),
        "dropped": int(meta.get("dropped", 0) or 0),
        "non_parked": int(meta.get("non_parked", 0) or 0),
        "stock_positive": int(meta.get("stock_positive", 0) or 0),
        "dropped_included_stock_positive": int(meta.get("dropped_included_stock_positive", 0) or 0),
        "excluded_stock_zero_or_missing": int(meta.get("excluded_stock_zero_or_missing", 0) or 0),
        "excluded_dropped_stock_zero": int(meta.get("excluded_dropped_stock_zero", 0) or 0),
        "stock_source": 1 if _norm(meta.get("stock_source_path", "")) else 0,
    }


def _read_csv_rows(path: Path) -> tuple[list[str], list[dict[str, str]]]:
    if not path.exists():
        return [], []
    with path.open("r", encoding="utf-8", newline="") as fh:
        reader = csv.DictReader(fh)
        rows = [{str(k): str(v or "") for k, v in row.items()} for row in reader]
        return list(reader.fieldnames or []), rows


def _upsert_csv_rows(path: Path, rows: list[dict[str, str]], *, key_cols: tuple[str, ...], preferred_order: list[str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    existing_fields, existing_rows = _read_csv_rows(path)
    index: dict[tuple[str, ...], dict[str, str]] = {}
    merged: list[dict[str, str]] = []

    for row in existing_rows:
        key = tuple(str(row.get(col, "")).strip() for col in key_cols)
        if key in index:
            continue
        normalized = {str(k): str(v or "") for k, v in row.items()}
        index[key] = normalized
        merged.append(normalized)

    for row in rows:
        normalized = {str(k): str(v or "") for k, v in row.items()}
        key = tuple(str(normalized.get(col, "")).strip() for col in key_cols)
        if key in index:
            index[key].update(normalized)
        else:
            index[key] = normalized
            merged.append(index[key])

    field_order: list[str] = []
    seen: set[str] = set()
    for col in preferred_order + existing_fields:
        if col and col not in seen:
            seen.add(col)
            field_order.append(col)
    for row in merged:
        for col in row.keys():
            if col and col not in seen:
                seen.add(col)
                field_order.append(col)

    with path.open("w", encoding="utf-8", newline="") as fh:
        writer = csv.DictWriter(fh, fieldnames=field_order)
        writer.writeheader()
        for row in merged:
            writer.writerow({col: str(row.get(col, "")) for col in field_order})


def _read_rows_for_date(path: Path, *, date_utc: str) -> list[dict[str, str]]:
    _, rows = _read_csv_rows(path)
    date_key = _norm(date_utc)
    return [row for row in rows if _norm(row.get("date_utc", "")) == date_key]


def _read_daily_row(path: Path, *, date_utc: str, sku: str) -> dict[str, str]:
    _, rows = _read_csv_rows(path)
    sku_key = _norm(sku).upper()
    date_key = _norm(date_utc)
    for row in reversed(rows):
        if _norm(row.get("date_utc", "")) == date_key and _norm(row.get("sku", "")).upper() == sku_key:
            return dict(row)
    return {}


def _with_compliance_metadata(row: dict[str, str], *, reason_code: str = "") -> dict[str, str]:
    out = {str(k): str(v or "") for k, v in row.items()}
    compliance = _norm(out.get("compliance_ceiling_landed_gbp", ""))
    if compliance:
        out["compliance_status"] = "OK"
        out["compliance_reason_code"] = ""
        return out
    out["compliance_status"] = _norm(out.get("compliance_status", "")) or "MISSING"
    out["compliance_reason_code"] = _norm(out.get("compliance_reason_code", "")) or _norm(reason_code) or "COMPLIANCE_CEILING_EMPTY"
    return out


def _build_fallback_row(*, date_utc: str, sku: str, parked_flag: str, park_reason_codes: list[str], reason_code: str) -> dict[str, str]:
    row = {col: "" for col in _daily_intel_schema()}
    row.update(
        {
            "date_utc": _norm(date_utc),
            "sku": _norm(sku).upper(),
            "parked_flag": "1" if _norm(parked_flag) == "1" else "0",
            "park_reason_codes_json": json.dumps([str(x).strip() for x in park_reason_codes if str(x).strip()], ensure_ascii=True),
            "compliance_status": "MISSING",
            "compliance_reason_code": _norm(reason_code) or "A016_ROW_BUILD_FAILED",
        }
    )
    return row


@contextmanager
def _isolated_phase1_data_dir() -> Path:
    original_data_dir = phase1_storage.DATA_DIR
    original_env_data_dir = os.environ.get("PHASE1_DATA_DIR")
    with tempfile.TemporaryDirectory(prefix="a016_alignment_") as td:
        temp_path = Path(td)
        os.environ["PHASE1_DATA_DIR"] = str(temp_path)
        phase1_storage.DATA_DIR = temp_path
        try:
            yield temp_path
        finally:
            phase1_storage.DATA_DIR = original_data_dir
            if original_env_data_dir is None:
                os.environ.pop("PHASE1_DATA_DIR", None)
            else:
                os.environ["PHASE1_DATA_DIR"] = original_env_data_dir


def main() -> int:
    parser = argparse.ArgumentParser(description="A016 - Refresh Phase 1 daily intel")
    parser.add_argument("--phase1-config", default=str(DEFAULT_CONFIG_PATH), help="Path to phase1 YAML config")
    parser.add_argument("--mode", choices=["full_universe", "single_sku"], default="full_universe", help="A016 run mode")
    parser.add_argument(
        "--scope",
        choices=["full_db", "single_sku"],
        default="",
        help="Deprecated alias for --mode (full_db->full_universe)",
    )
    parser.add_argument("--sku", default="", help="Required when --scope single_sku")
    parser.add_argument("--max-skus", type=int, default=0, help="Optional cap for full_universe mode")
    parser.add_argument("--dry-run", action="store_true", help="Do not write sku_daily_intel rows")
    parser.add_argument("--force", action="store_true", help="Reserved for parity")
    args = parser.parse_args()

    cfg_path = Path(args.phase1_config)
    if not cfg_path.is_absolute():
        cfg_path = ROOT / cfg_path
    cfg = _load_cfg(cfg_path)

    now_utc = datetime.now(timezone.utc).replace(microsecond=0).strftime("%Y-%m-%dT%H:%M:%SZ")
    run_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    progress_run_id = _norm(os.environ.get("H_RUN_ID", "")) or run_id
    _start_parent_loss_monitor(progress_run_id)
    sku_trace = _sku_trace_enabled()
    fault_timeout_seconds = max(_to_int(os.environ.get("A016_FAULT_TIMEOUT_SECONDS", "0")) or 0, 0)
    if fault_timeout_seconds > 0:
        try:
            faulthandler.enable()
        except Exception:
            pass
        try:
            faulthandler.dump_traceback_later(float(fault_timeout_seconds), repeat=True)
            _append_intel_progress(progress_run_id, "faulthandler_armed", timeout_seconds=fault_timeout_seconds)
        except Exception:
            pass
    _write_boundary_state(
        progress_run_id,
        "active",
        contract_stage="start",
        mode=_norm(args.mode),
        config_path=cfg_path,
        result_path=A016_RESULT_PATH if A016_RESULT_PATH else "",
    )
    _append_intel_progress(progress_run_id, "start", mode=_norm(args.mode), config_path=cfg_path)
    listing_map = _latest_listing_map()
    manual_cap_by_sku, manual_cap_by_asin = _load_manual_caps()
    high_pct = float(_norm(_cfg_get(cfg, "daily_intel", "cpt_high_risk_pct", default="5")) or "5")
    medium_pct = float(_norm(_cfg_get(cfg, "daily_intel", "cpt_medium_risk_pct", default="2")) or "2")
    cpt_call_spacing_seconds = max(_cfg_float(cfg, "daily_intel", "cpt_call_spacing_seconds", default=31.0), 0.0)
    cpt_no_value_recheck_hours = max(_cfg_float(cfg, "daily_intel", "cpt_no_value_recheck_hours", default=168.0), 1.0)
    cpt_max_age_hours = max(_cfg_float(cfg, "daily_intel", "cpt_max_age_hours", default=24.0), 1.0)
    cpt_call_timeout_seconds = max(_to_float(os.environ.get("A016_CPT_CALL_TIMEOUT_SECONDS", "25")) or 25.0, 5.0)
    cpt_connect_timeout_seconds = max(
        _to_float(os.environ.get("A016_CPT_CONNECT_TIMEOUT_SECONDS", "5")) or 5.0,
        1.0,
    )
    cpt_read_timeout_seconds = max(
        _to_float(os.environ.get("A016_CPT_READ_TIMEOUT_SECONDS", "20")) or 20.0,
        5.0,
    )
    cpt_token_timeout_seconds = max(
        _to_float(os.environ.get("A016_CPT_TOKEN_TIMEOUT_SECONDS", "15")) or 15.0,
        5.0,
    )
    loop_heartbeat_every = max(_to_int(os.environ.get("A016_LOOP_HEARTBEAT_EVERY", "5")) or 5, 1)
    slow_step_heartbeat_seconds = max(
        _to_float(os.environ.get("A016_SLOW_STEP_HEARTBEAT_SECONDS", "15")) or 15.0,
        5.0,
    )

    scope_df, scope_path = phase1_sku_scope.build_and_write_scope(asof_utc=now_utc)
    mode = _norm(args.mode).lower()
    if _norm(args.scope):
        scope_mode = _norm(args.scope).lower()
        mode = "single_sku" if scope_mode == "single_sku" else "full_universe"
    scope_mode = "single_sku" if mode == "single_sku" else "full_universe"
    single_sku = _norm(args.sku).upper() or _norm(_cfg_get(cfg, "sku", default="")).upper()
    target_cfg: dict[str, object] = dict(cfg)
    if mode == "single_sku":
        if not single_sku:
            raise SystemExit("[A016] --sku is required when --mode single_sku")
        target_cfg["target_universe_mode"] = "single_sku"
        target_cfg["pilot_whitelist_sku"] = single_sku
        target_cfg["pilot_whitelist_skus"] = single_sku
        target_cfg["sku"] = single_sku

    required_skus: list[str] = []
    if mode == "full_universe":
        required_skus, universe_counts = _load_required_non_parked_skus(scope_df)
        target_skus = [str(s).strip().upper() for s in required_skus if str(s).strip()]
        target_universe = {
            "mode": "full_universe",
            "mode_source": "a016_mode",
            "source": "a015_required_non_parked",
            "skus": target_skus,
            "resolved_count": len(target_skus),
            "candidate_count": len(target_skus),
            "skipped_no_listing_count": 0,
            "skipped_out_of_stock_count": 0,
            "notes_csv": (
                f"required={universe_counts.get('required', 0)},"
                f"dropped={universe_counts.get('dropped', 0)},"
                f"non_parked={universe_counts.get('non_parked', 0)}"
            ),
        }
    else:
        target_universe = resolve_target_universe(target_cfg, out_dir=OUT)
        target_skus = [
            _norm(s).upper()
            for s in (target_universe.get("skus") or [])
            if _norm(s)
        ]
        if not target_skus:
            raise SystemExit(f"[A016] SKU not resolved from config/scope: {single_sku}")

    max_skus = max(int(args.max_skus), 0)
    if mode == "full_universe" and max_skus > 0:
        target_skus = target_skus[:max_skus]

    scope_rows = [{str(k): _norm(v) for k, v in r.items()} for r in scope_df.to_dict(orient="records")]
    scope_by_sku = {
        _norm(r.get("sku", "")).upper(): r
        for r in scope_rows
        if _norm(r.get("sku", ""))
    }
    rows: list[dict[str, str]] = []
    authoritative_daily_intel_path = _active_authoritative_daily_intel_path()
    for sku in target_skus:
        rec = scope_by_sku.get(sku)
        if rec is None:
            rec = {
                "sku": sku,
                "asin": "",
                "writer_mode": "READ_ONLY",
                "cpt_tier": "ACTIVE_READONLY",
                "parked_flag": "0",
                "park_reason_codes": "",
            }
        rows.append(rec)
    _append_intel_progress(
        progress_run_id,
        "inputs_loaded",
        target_skus=len(target_skus),
        scope_rows=len(scope_df.index),
        mode=mode,
    )
    _write_boundary_state(
        progress_run_id,
        "active",
        contract_stage="inputs_loaded",
        target_skus=len(target_skus),
        scope_rows=len(scope_df.index),
        mode=mode,
    )

    processed = 0
    cpt_calls = 0
    cpt_due_stale_count = 0
    cpt_due_missing_error_count = 0
    cpt_due_no_cpt_weekly_count = 0
    cpt_skip_no_cpt_weekly_count = 0
    cpt_no_cpt_rows = 0
    cpt_reused_or_skipped_count = 0
    coverage_missing = 0
    dry_run_plans = 0
    fallback_rows = 0
    last_result: phase1_main_loop.AcycleResult | None = None
    last_cpt_call_started_monotonic: float | None = None
    total_rows = len(rows)

    for loop_index, rec in enumerate(rows, start=1):
        sku = _norm(rec.get("sku", "")).upper()
        if not sku:
            continue
        if sku_trace:
            _append_intel_progress(progress_run_id, "sku_start", sku=sku)
        listing_row = listing_map.get(sku, {})
        asin = _norm(rec.get("asin", "")).upper() or _norm(listing_row.get("asin", "")).upper()
        writer_mode = _norm(rec.get("writer_mode", "")).upper() or "READ_ONLY"
        tier = _norm(rec.get("cpt_tier", "")).upper() or ("ACTIVE_WRITE" if writer_mode == "CODEX_H" else "ACTIVE_READONLY")
        parked_flag = _norm(rec.get("parked_flag", "")) or "0"
        park_reasons = [x for x in _norm(rec.get("park_reason_codes", "")).split("|") if x]
        if loop_index == 1 or loop_index % loop_heartbeat_every == 0:
            _append_intel_progress(
                progress_run_id,
                "loop_progress",
                **_loop_progress_fields(
                    sku=sku,
                    loop_index=loop_index,
                    total_rows=total_rows,
                    step="sku_loop",
                    writer_mode=writer_mode,
                    asin=asin,
                    extra={"processed_rows": processed},
                ),
            )

        with _loop_step_heartbeat(
            run_id=progress_run_id,
            sku=sku,
            loop_index=loop_index,
            total_rows=total_rows,
            step="phase1_storage.read_latest",
            writer_mode=writer_mode,
            asin=asin,
            slow_step_seconds=slow_step_heartbeat_seconds,
        ):
            if sku_trace:
                _append_sku_trace(progress_run_id, sku, "phase1_storage.read_latest", "before")
            latest_daily = phase1_storage.read_latest("sku_daily_intel", {"sku": sku}) or {}
            if sku_trace:
                _append_sku_trace(progress_run_id, sku, "phase1_storage.read_latest", "after")
        latest_cpt_status = _norm(latest_daily.get("cpt_status", "")) or "MISSING"
        last_cpt_refresh = _norm(latest_daily.get("cpt_last_refresh_utc", ""))
        should_call_cpt, cpt_call_reason_codes, cpt_due_bucket = _cpt_age_due(
            tier=tier,
            cpt_status=latest_cpt_status,
            last_refresh_utc=last_cpt_refresh,
            now_utc=now_utc,
            no_cpt_recheck_hours=cpt_no_value_recheck_hours,
        )
        if cpt_due_bucket == "DUE_STALE":
            cpt_due_stale_count += 1
        elif cpt_due_bucket == "DUE_MISSING_ERROR":
            cpt_due_missing_error_count += 1
        elif cpt_due_bucket == "DUE_NO_CPT_WEEKLY":
            cpt_due_no_cpt_weekly_count += 1
        elif cpt_due_bucket == "SKIP_NO_CPT_WEEKLY":
            cpt_skip_no_cpt_weekly_count += 1

        cpt_payload = {
            "cpt_gbp": _norm(latest_daily.get("cpt_gbp", "")),
            "cpt_status": latest_cpt_status,
            "cpt_last_refresh_utc": _norm(latest_daily.get("cpt_last_refresh_utc", "")) or now_utc,
            "reason_codes": [],
            "error_summary": "",
        }

        if tier == "PARKED":
            cpt_call_reason_codes = ["CPT_SKIP_PARKED"]
            cpt_reused_or_skipped_count += 1
        elif not asin:
            cpt_call_reason_codes.append("CPT_SKIP_NO_ASIN")
            cpt_payload["cpt_status"] = "MISSING"
            cpt_reused_or_skipped_count += 1
        elif should_call_cpt and args.dry_run:
            cpt_call_reason_codes.append("CPT_SKIP_DRY_RUN")
            cpt_reused_or_skipped_count += 1
        elif should_call_cpt:
            if cpt_call_spacing_seconds > 0 and last_cpt_call_started_monotonic is not None:
                elapsed = max(time.monotonic() - last_cpt_call_started_monotonic, 0.0)
                wait_seconds = cpt_call_spacing_seconds - elapsed
                if wait_seconds > 0:
                    time.sleep(wait_seconds)
                    cpt_call_reason_codes.append(f"CPT_CALL_SPACING_WAIT_{wait_seconds:.1f}S")
            last_cpt_call_started_monotonic = time.monotonic()
            with _loop_step_heartbeat(
                run_id=progress_run_id,
                sku=sku,
                loop_index=loop_index,
                total_rows=total_rows,
                step="fetch_cpt_for_asin",
                cpt_due_bucket=cpt_due_bucket,
                writer_mode=writer_mode,
                asin=asin,
                slow_step_seconds=slow_step_heartbeat_seconds,
                extra_enter={"cpt_status_before": latest_cpt_status},
            ):
                if sku_trace:
                    _append_sku_trace(progress_run_id, sku, "fetch_cpt_for_asin", "before", asin=asin)
                cpt_payload, cpt_failfast_reason = _fetch_cpt_with_deadline(
                    sku=sku,
                    asin=asin,
                    marketplace_id=_norm(_cfg_get(cfg, "marketplace_id", default="")) or "A1F83G8C2ARO7P",
                    run_id=run_id,
                    script_name=SOURCE,
                    timeout_seconds=cpt_call_timeout_seconds,
                    connect_timeout_seconds=cpt_connect_timeout_seconds,
                    read_timeout_seconds=cpt_read_timeout_seconds,
                    token_timeout_seconds=cpt_token_timeout_seconds,
                )
                if sku_trace:
                    _append_sku_trace(
                        progress_run_id,
                        sku,
                        "fetch_cpt_for_asin",
                        "after",
                        asin=asin,
                        cpt_status=_norm(cpt_payload.get("cpt_status", "")),
                    )
            cpt_calls += 1
            if cpt_failfast_reason:
                cpt_call_reason_codes.append(f"CPT_FAIL_FAST_{cpt_failfast_reason.upper()}")
                print(
                    "[A016] WARN cpt_call_fail_fast "
                    f"sku={sku} asin={asin} reason={cpt_failfast_reason} "
                    f"timeout_seconds={cpt_call_timeout_seconds:.1f}"
                )
            else:
                cpt_call_reason_codes.append("CPT_CALL_PERFORMED")
        else:
            cpt_call_reason_codes.append("CPT_REUSE_LAST")
            cpt_reused_or_skipped_count += 1
            _append_intel_progress(
                progress_run_id,
                "loop_step_skip",
                **_loop_progress_fields(
                    sku=sku,
                    loop_index=loop_index,
                    total_rows=total_rows,
                    step="fetch_cpt_for_asin",
                    cpt_due_bucket=cpt_due_bucket,
                    writer_mode=writer_mode,
                    asin=asin,
                    extra={"reason": "|".join(cpt_call_reason_codes[:6])},
                ),
            )

        cpt_status = _norm(cpt_payload.get("cpt_status", "MISSING")).upper() or "MISSING"
        if cpt_status == "NO_CPT":
            cpt_no_cpt_rows += 1
        cpt_gbp = _norm(cpt_payload.get("cpt_gbp", ""))
        cpt_last_refresh = _norm(cpt_payload.get("cpt_last_refresh_utc", "")) or now_utc
        # Operator rule: if CPT exists and is OK, use it for ceiling input regardless of age.
        cpt_last_refresh_dt = _to_dt(cpt_last_refresh)
        now_dt = _to_dt(now_utc)
        cpt_is_fresh = bool(
            cpt_last_refresh_dt
            and now_dt
            and (now_dt - cpt_last_refresh_dt) <= timedelta(hours=cpt_max_age_hours)
        )
        cpt_ceiling_input_gbp = cpt_gbp if (cpt_status == "OK" and _to_float(cpt_gbp)) else ""
        if cpt_ceiling_input_gbp and cpt_is_fresh:
            cpt_call_reason_codes.append("CPT_CEILING_INPUT_FRESH")
        elif cpt_ceiling_input_gbp:
            cpt_call_reason_codes.append("CPT_CEILING_INPUT_STALE_ALLOWED")
        else:
            cpt_call_reason_codes.append("CPT_CEILING_INPUT_MISSING")
        cpt_reason_codes = [str(x).strip() for x in (cpt_payload.get("reason_codes") or []) if str(x).strip()]
        cpt_error_summary = _norm(cpt_payload.get("error_summary", ""))
        if cpt_error_summary:
            cpt_call_reason_codes.append(f"CPT_ERROR_SUMMARY:{cpt_error_summary[:120]}")

        buy_box = _norm(listing_row.get("buy_box_price", ""))
        cpt_risk_band, cpt_delta_gbp, cpt_delta_pct, cpt_risk_reasons = _compute_cpt_risk(
            cpt_gbp=cpt_gbp,
            buy_box_gbp=buy_box,
            high_pct=high_pct,
            medium_pct=medium_pct,
        )
        cpt_call_reason_codes.extend(cpt_reason_codes + cpt_risk_reasons)

        manual_cap = _resolve_manual_cap(
            sku=sku,
            asin=asin,
            listing_row=listing_row,
            cfg=cfg,
            manual_cap_by_sku=manual_cap_by_sku,
            manual_cap_by_asin=manual_cap_by_asin,
        )
        compliance_anchor = _resolve_compliance_anchor(
            listing_row=listing_row,
            manual_cap_gbp=manual_cap,
            cfg=cfg,
        )
        extra_reason_codes = []
        if not _norm(compliance_anchor):
            extra_reason_codes.append("COMPLIANCE_ANCHOR_MISSING")
        if not _norm(manual_cap):
            extra_reason_codes.append("MANUAL_CAP_MISSING")

        if args.dry_run:
            dry_run_plans += 1
            processed += 1
            continue

        try:
            if mode == "single_sku":
                with _isolated_phase1_data_dir() as temp_dir:
                    with _loop_step_heartbeat(
                        run_id=progress_run_id,
                        sku=sku,
                        loop_index=loop_index,
                        total_rows=total_rows,
                        step="phase1_main_loop.run_a_cycle",
                        cpt_due_bucket=cpt_due_bucket,
                        writer_mode=writer_mode,
                        asin=asin,
                        slow_step_seconds=slow_step_heartbeat_seconds,
                        extra_enter={"mode": mode, "tier": tier},
                    ):
                        if sku_trace:
                            _append_sku_trace(progress_run_id, sku, "phase1_main_loop.run_a_cycle", "before", mode=mode)
                        result = phase1_main_loop.run_a_cycle(
                            sku=sku,
                            now_utc=now_utc,
                            compliance_anchor_gbp=compliance_anchor,
                            policy_buffer_pct=_cfg_get(cfg, "boundaries", "policy_buffer_pct", default="0.03"),
                            manual_cap_gbp=manual_cap,
                            foep_price_gbp=_cfg_get(cfg, "daily_intel", "foep_price_gbp", default=buy_box),
                            foep_status=_cfg_get(cfg, "daily_intel", "foep_status", default="MISSING"),
                            foep_last_refresh_utc=_cfg_get(cfg, "daily_intel", "foep_last_refresh_utc", default=now_utc),
                            cpt_gbp=cpt_gbp,
                            cpt_last_refresh_utc=cpt_last_refresh,
                            cpt_ceiling_input_gbp=cpt_ceiling_input_gbp,
                            cpt_status=cpt_status,
                            last_known_safe_gbp=_cfg_get(cfg, "daily_intel", "last_known_safe_gbp", default=_norm(listing_row.get("our_price", ""))),
                            foep_stale_hours=int(float(_cfg_get(cfg, "eligibility", "foep_stale_hours", default=48))),
                            foep_sanity_min_mult=_cfg_get(cfg, "eligibility", "foep_sanity_min_mult", default="0.50"),
                            foep_sanity_max_mult=_cfg_get(cfg, "eligibility", "foep_sanity_max_mult", default="2.00"),
                            market_reference_price_gbp=_cfg_get(cfg, "daily_intel", "market_reference_price_gbp", default=buy_box),
                            extra_reason_codes=extra_reason_codes,
                            cpt_risk_band=cpt_risk_band,
                            cpt_delta_vs_buy_box_gbp=cpt_delta_gbp,
                            cpt_delta_vs_buy_box_pct=cpt_delta_pct,
                            cpt_call_tier=tier,
                            cpt_call_reason_codes=cpt_call_reason_codes,
                            parked_flag=parked_flag,
                            park_reason_codes=park_reasons,
                            bbp_max_sold_gbp=manual_cap,
                            competitive_price_threshold_gbp=cpt_gbp,
                            competitive_price_gbp="",
                            average_selling_price_gbp="",
                            anchor_floor_price_gbp="",
                        )
                        if sku_trace:
                            _append_sku_trace(progress_run_id, sku, "phase1_main_loop.run_a_cycle", "after", mode=mode)
                    row_path = temp_dir / "sku_daily_intel.csv"
                    row = _read_daily_row(row_path, date_utc=now_utc[:10], sku=sku)
                if not row:
                    row = _build_fallback_row(
                        date_utc=now_utc[:10],
                        sku=sku,
                        parked_flag=parked_flag,
                        park_reason_codes=park_reasons,
                        reason_code="ALIGNMENT_ROW_MISSING",
                    )
                row = _with_compliance_metadata(row)
                _upsert_csv_rows(
                    ALIGNMENT_DAILY_INTEL_PATH,
                    [row],
                    key_cols=("date_utc", "sku"),
                    preferred_order=_daily_intel_schema(),
                )
            else:
                with _loop_step_heartbeat(
                    run_id=progress_run_id,
                    sku=sku,
                    loop_index=loop_index,
                    total_rows=total_rows,
                    step="phase1_main_loop.run_a_cycle",
                    cpt_due_bucket=cpt_due_bucket,
                    writer_mode=writer_mode,
                    asin=asin,
                    slow_step_seconds=slow_step_heartbeat_seconds,
                    extra_enter={"mode": mode, "tier": tier},
                ):
                    if sku_trace:
                        _append_sku_trace(progress_run_id, sku, "phase1_main_loop.run_a_cycle", "before", mode=mode)
                    result = phase1_main_loop.run_a_cycle(
                        sku=sku,
                        now_utc=now_utc,
                        compliance_anchor_gbp=compliance_anchor,
                        policy_buffer_pct=_cfg_get(cfg, "boundaries", "policy_buffer_pct", default="0.03"),
                        manual_cap_gbp=manual_cap,
                        foep_price_gbp=_cfg_get(cfg, "daily_intel", "foep_price_gbp", default=buy_box),
                        foep_status=_cfg_get(cfg, "daily_intel", "foep_status", default="MISSING"),
                        foep_last_refresh_utc=_cfg_get(cfg, "daily_intel", "foep_last_refresh_utc", default=now_utc),
                        cpt_gbp=cpt_gbp,
                        cpt_last_refresh_utc=cpt_last_refresh,
                        cpt_ceiling_input_gbp=cpt_ceiling_input_gbp,
                        cpt_status=cpt_status,
                        last_known_safe_gbp=_cfg_get(cfg, "daily_intel", "last_known_safe_gbp", default=_norm(listing_row.get("our_price", ""))),
                        foep_stale_hours=int(float(_cfg_get(cfg, "eligibility", "foep_stale_hours", default=48))),
                        foep_sanity_min_mult=_cfg_get(cfg, "eligibility", "foep_sanity_min_mult", default="0.50"),
                        foep_sanity_max_mult=_cfg_get(cfg, "eligibility", "foep_sanity_max_mult", default="2.00"),
                        market_reference_price_gbp=_cfg_get(cfg, "daily_intel", "market_reference_price_gbp", default=buy_box),
                        extra_reason_codes=extra_reason_codes,
                        cpt_risk_band=cpt_risk_band,
                        cpt_delta_vs_buy_box_gbp=cpt_delta_gbp,
                        cpt_delta_vs_buy_box_pct=cpt_delta_pct,
                        cpt_call_tier=tier,
                        cpt_call_reason_codes=cpt_call_reason_codes,
                        parked_flag=parked_flag,
                        park_reason_codes=park_reasons,
                        bbp_max_sold_gbp=manual_cap,
                        competitive_price_threshold_gbp=cpt_gbp,
                        competitive_price_gbp="",
                        average_selling_price_gbp="",
                        anchor_floor_price_gbp="",
                    )
                    if sku_trace:
                        _append_sku_trace(progress_run_id, sku, "phase1_main_loop.run_a_cycle", "after", mode=mode)
                row = _read_daily_row(authoritative_daily_intel_path, date_utc=now_utc[:10], sku=sku)
                if row:
                    row = _with_compliance_metadata(row)
                    _upsert_csv_rows(
                        authoritative_daily_intel_path,
                        [row],
                        key_cols=("date_utc", "sku"),
                        preferred_order=_daily_intel_schema(),
                    )
            processed += 1
            last_result = result
            if not _norm(result.compliance_ceiling_landed_gbp):
                coverage_missing += 1
            if loop_index == total_rows or loop_index % loop_heartbeat_every == 0:
                _append_intel_progress(
                    progress_run_id,
                    "sku_complete",
                    **_loop_progress_fields(
                        sku=sku,
                        loop_index=loop_index,
                        total_rows=total_rows,
                        step="sku_complete",
                        cpt_due_bucket=cpt_due_bucket,
                        writer_mode=writer_mode,
                        asin=asin,
                        extra={"processed_rows": processed},
                    ),
                )
        except Exception as exc:
            fallback_rows += 1
            fallback = _build_fallback_row(
                date_utc=now_utc[:10],
                sku=sku,
                parked_flag=parked_flag,
                park_reason_codes=park_reasons,
                reason_code=f"A016_EXCEPTION_{type(exc).__name__.upper()}",
            )
            target_path = ALIGNMENT_DAILY_INTEL_PATH if mode == "single_sku" else authoritative_daily_intel_path
            _upsert_csv_rows(
                target_path,
                [fallback],
                key_cols=("date_utc", "sku"),
                preferred_order=_daily_intel_schema(),
            )
            processed += 1
            coverage_missing += 1
            print(f"[A016] WARN sku={sku} fallback_row_written reason={type(exc).__name__}")

    total_scope_rows = len(scope_df.index)
    total_parked = int(scope_df.get("parked_flag", "").astype(str).str.strip().eq("1").sum()) if not scope_df.empty else 0
    total_non_parked = total_scope_rows - total_parked

    output_path = authoritative_daily_intel_path if mode == "full_universe" else ALIGNMENT_DAILY_INTEL_PATH
    _append_intel_progress(
        progress_run_id,
        "alignment_done",
        processed=processed,
        fallback_rows=fallback_rows,
        output_path=output_path,
    )
    _write_boundary_state(
        progress_run_id,
        "active",
        contract_stage="alignment_done",
        processed=processed,
        fallback_rows=fallback_rows,
        output_path=output_path,
    )
    today_key = now_utc[:10]
    repaired_rows = 0
    if mode == "full_universe":
        existing_today = _read_rows_for_date(output_path, date_utc=today_key)
        existing_skus = {_norm(r.get("sku", "")).upper() for r in existing_today if _norm(r.get("sku", ""))}
        missing_required = [sku for sku in required_skus if sku and sku not in existing_skus]
        if missing_required:
            repair_rows = [
                _build_fallback_row(
                    date_utc=today_key,
                    sku=sku,
                    parked_flag="0",
                    park_reason_codes=[],
                    reason_code="A016_POSTRUN_COVERAGE_REPAIR",
                )
                for sku in missing_required
            ]
            _upsert_csv_rows(
                output_path,
                repair_rows,
                key_cols=("date_utc", "sku"),
                preferred_order=_daily_intel_schema(),
            )
            repaired_rows = len(repair_rows)
            fallback_rows += repaired_rows
            coverage_missing += repaired_rows
            print(
                "[A016] WARN postrun_coverage_repair "
                f"date_utc={today_key} repaired_rows={repaired_rows} "
                f"missing_sample={','.join(missing_required[:5])}"
            )

    today_rows = _read_rows_for_date(output_path, date_utc=today_key)
    today_skus = {_norm(r.get("sku", "")).upper() for r in today_rows if _norm(r.get("sku", ""))}
    if mode == "full_universe":
        missing_after_repair = [sku for sku in required_skus if sku and sku not in today_skus]
        required_value = str(len(required_skus))
        missing_after_value = str(len(missing_after_repair))
        missing_sample_value = ",".join(missing_after_repair[:5])
    else:
        required_value = "single_sku_mode"
        missing_after_value = "n/a"
        missing_sample_value = ""
    print(
        "a016_decision "
        f"date_utc={today_key};scope_file={scope_path};output_path={output_path};"
        f"output_exists={'1' if output_path.exists() else '0'};"
        f"rows_today={len(today_rows)};unique_skus_today={len(today_skus)};"
        f"required_non_parked_non_dropped={required_value};"
        f"missing_after_repair={missing_after_value};"
        f"repaired_rows={repaired_rows};"
        f"missing_sample={missing_sample_value}"
    )
    _append_intel_progress(
        progress_run_id,
        "outputs_written",
        rows_today=len(today_rows),
        output_path=output_path,
    )
    _write_boundary_state(
        progress_run_id,
        "active",
        contract_stage="outputs_written",
        output_path=output_path,
        rows_today=len(today_rows),
        processed=processed,
        fallback_rows=fallback_rows,
    )
    print(f"a016_mode={mode}")
    print(f"a016_scope={scope_mode}")
    print(f"a016_output_path={output_path}")
    print(f"a016_target_universe_mode={_norm(target_universe.get('mode', ''))}")
    print(f"a016_target_universe_source={_norm(target_universe.get('source', ''))}")
    print(f"a016_target_universe_mode_source={_norm(target_universe.get('mode_source', ''))}")
    print(f"a016_target_universe_candidate_count={_to_int(target_universe.get('candidate_count', 0)) or 0}")
    print(f"a016_target_universe_resolved_count={_to_int(target_universe.get('resolved_count', 0)) or 0}")
    print(
        "a016_target_universe_skipped_no_listing_count="
        f"{_to_int(target_universe.get('skipped_no_listing_count', 0)) or 0}"
    )
    print(
        "a016_target_universe_skipped_out_of_stock_count="
        f"{_to_int(target_universe.get('skipped_out_of_stock_count', 0)) or 0}"
    )
    print(f"a016_target_universe_notes={_norm(target_universe.get('notes_csv', ''))}")
    print(f"a016_scope_file={scope_path}")
    print(f"a016_scope_rows={total_scope_rows}")
    print(f"a016_scope_non_parked={total_non_parked}")
    print(f"a016_scope_parked={total_parked}")
    print(f"a016_processed={processed}")
    print(f"a016_cpt_calls={cpt_calls}")
    print(f"a016_cpt_due_stale={cpt_due_stale_count}")
    print(f"a016_cpt_due_missing_error={cpt_due_missing_error_count}")
    print(f"a016_cpt_due_no_cpt_weekly={cpt_due_no_cpt_weekly_count}")
    print(f"a016_cpt_skip_no_cpt_weekly={cpt_skip_no_cpt_weekly_count}")
    print(f"a016_cpt_no_cpt_rows={cpt_no_cpt_rows}")
    print(f"a016_cpt_no_value_recheck_hours={cpt_no_value_recheck_hours:.2f}")
    print(f"a016_cpt_max_age_hours={cpt_max_age_hours:.2f}")
    print(f"a016_cpt_reused_or_skipped={cpt_reused_or_skipped_count}")
    print(f"a016_cpt_call_spacing_seconds={cpt_call_spacing_seconds:.2f}")
    print(f"a016_missing_compliance_rows={coverage_missing}")
    print(f"a016_fallback_rows={fallback_rows}")
    if args.dry_run:
        print(f"a016_dry_run_plans={dry_run_plans}")
    if last_result is not None:
        print(f"a016_sku={last_result.sku}")
        print(f"a016_date={last_result.date_utc}")
        print(f"a016_cpt_status={last_result.cpt_status}")
        print(f"a016_compliance_ceiling={last_result.compliance_ceiling_landed_gbp}")
        print(f"a016_eligibility_source={last_result.eligibility_source}")
        print(f"a016_eligibility_ceiling={last_result.eligibility_ceiling_landed_gbp}")
    success_payload = {
        "phase1_daily_intel_alignment_status": "ok",
        "phase1_daily_intel_alignment_run_id": progress_run_id,
        "phase1_daily_intel_alignment_utc": now_utc,
        "phase1_daily_intel_alignment_mode": mode,
        "phase1_daily_intel_alignment_scope": scope_mode,
        "phase1_daily_intel_alignment_output_path": str(output_path),
        "phase1_daily_intel_alignment_target_mode": _norm(target_universe.get("mode", "")),
        "phase1_daily_intel_alignment_target_source": _norm(target_universe.get("source", "")),
        "phase1_daily_intel_alignment_target_mode_source": _norm(target_universe.get("mode_source", "")),
        "phase1_daily_intel_alignment_target_candidate_count": str(_to_int(target_universe.get("candidate_count", 0)) or 0),
        "phase1_daily_intel_alignment_target_resolved_count": str(_to_int(target_universe.get("resolved_count", 0)) or 0),
        "phase1_daily_intel_alignment_scope_file": str(scope_path),
        "phase1_daily_intel_alignment_scope_rows": str(total_scope_rows),
        "phase1_daily_intel_alignment_processed_count": str(processed),
        "phase1_daily_intel_alignment_cpt_calls": str(cpt_calls),
        "phase1_daily_intel_alignment_missing_compliance_rows": str(coverage_missing),
        "phase1_daily_intel_alignment_fallback_rows": str(fallback_rows),
        "phase1_daily_intel_alignment_rows_today": str(len(today_rows)),
    }
    _emit_success_payload(success_payload)
    _PARENT_LOSS_MONITOR_STOP.set()
    _append_intel_progress(progress_run_id, "end", status="ok", processed=processed)
    if fault_timeout_seconds > 0:
        try:
            faulthandler.cancel_dump_traceback_later()
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit as exc:
        _PARENT_LOSS_MONITOR_STOP.set()
        code = exc.code
        rc = int(code) if isinstance(code, int) else 1
        if rc != 0:
            _emit_failure_payload(
                {
                    "phase1_daily_intel_alignment_status": "failed",
                    "phase1_daily_intel_alignment_run_id": _norm(os.environ.get("H_RUN_ID", "")),
                    "phase1_daily_intel_alignment_rc": str(rc),
                    "phase1_daily_intel_alignment_error": _norm(code) or "system_exit",
                    "phase1_daily_intel_alignment_error_type": "SystemExit",
                }
            )
        raise
    except BaseException as exc:
        _PARENT_LOSS_MONITOR_STOP.set()
        _emit_failure_payload(
            {
                "phase1_daily_intel_alignment_status": "failed",
                "phase1_daily_intel_alignment_run_id": _norm(os.environ.get("H_RUN_ID", "")),
                "phase1_daily_intel_alignment_rc": "1",
                "phase1_daily_intel_alignment_error": f"{type(exc).__name__}:{exc}",
                "phase1_daily_intel_alignment_error_type": type(exc).__name__,
            }
        )
        raise


